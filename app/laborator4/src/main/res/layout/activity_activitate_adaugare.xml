<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ActivitateAdaugare"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="102dp"
            android:layout_height="wrap_content"
            android:text="@string/adauga_marca"/>

        <EditText
            android:id="@+id/marca_ET"
            android:layout_width="307dp"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/adauga_modelul" />

        <EditText
            android:id="@+id/model_ET"
            android:layout_width="307dp"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tipul_combustibilului"/>
        <Spinner
            android:id="@+id/combustibil_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/Lista_tipuri_combustibil"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recenzii_clienti" />

        <RatingBar
            android:id="@+id/recenzii_RB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>
    <CheckBox
        android:id="@+id/noua_CB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/este_noua"/>
    <Switch
        android:id="@+id/disponibila_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/este_disponibila"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adaugare_masina"
        android:onClick="trimitereInstanta"/>

</LinearLayout>