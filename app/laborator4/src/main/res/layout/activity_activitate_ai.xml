<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FC"
    android:fillViewport="true"
    android:clipToPadding="false"
    tools:context=".ActivitateAdaugare">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adaugă o mașină"
            android:textColor="#172B4D"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="Completează detaliile mașinii tale"
            android:textColor="#718096"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adauga_marca"
                android:textColor="#263653"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/marca_ET"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/input_background"
                android:hint="Ex. BMW"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:inputType="textCapWords"
                android:textColor="#172B4D"
                android:textColorHint="#9AA6B8"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adauga_modelul"
                android:textColor="#263653"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/model_ET"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/input_background"
                android:hint="Ex. Seria 3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:inputType="textCapWords"
                android:textColor="#172B4D"
                android:textColorHint="#9AA6B8"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tipul_combustibilului"
                android:textColor="#263653"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/combustibil_spinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/input_background"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:entries="@array/Lista_tipuri_combustibil"
                android:spinnerMode="dropdown" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recenzii_clienti"
                android:textColor="#263653"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RatingBar
                android:id="@+id/recenzii_RB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="22dp"
                android:numStars="5"
                android:stepSize="0.5"
                android:rating="0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Starea și disponibilitatea"
                android:textColor="#263653"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/noua_CB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#2563EB"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/este_noua"
                android:textColor="#40516D"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/disponibila_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/este_disponibila"
                android:textColor="#40516D"
                android:textSize="14sp"
                android:thumbTint="#FFFFFF"
                android:trackTint="#9CB9F8" />

        </LinearLayout>

        <Button
            android:id="@+id/adaugare_BTN"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#2563EB"
            android:elevation="2dp"
            android:onClick="trimitereInstanta"
            android:text="@string/adaugare_masina"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
